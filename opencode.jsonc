{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cd": "allow",
      "cat": "allow",
      "grep *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git status *": "allow",
      "head *": "allow",
    },
  },
  "plugin": [
    "./plugins/ponytail.mjs",
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true,
    },
    "svelte": {
      "type": "local",
      "command": ["npx", "-y", "@sveltejs/mcp"],
      "enabled": true,
    },
    "paradedb": {
      "type": "remote",
      "url": "https://www.paradedb.com/docs/mcp",
      "enabled": true,
    },
    // disabled: prompts Wix OAuth on every start; re-enable if working on Wix apps
    // "wix-mcp-remote": {
    //   "type": "remote",
    //   "url": "https://mcp.wix.com/mcp",
    //   "enabled": true,
    // },
  },
}
